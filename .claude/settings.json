{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "autoMemoryEnabled": false,
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/claude-md-guard.sh",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Write"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/claude-md-guard.sh",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Edit|MultiEdit|Bash"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stop-gate.sh",
            "statusMessage": "Checking CLAUDE.md budget and lint…",
            "timeout": 180,
            "type": "command"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(muninn why:*)",
      "Bash(muninn status:*)",
      "Bash(muninn show:*)"
    ]
  }
}
