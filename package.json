{
  "name": "ogmios",
  "private": true,
  "version": "0.8.0",
  "type": "module",
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "vite",
    "build": "tsgo --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsgo --noEmit",
    "format": "prettier --write --cache --cache-strategy content .",
    "format:check": "prettier --check --cache --cache-strategy content .",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix --fix-suggestions",
    "dupes": "similarity-ts src sidecar shared scripts -t 0.87 -m 6 --no-types --filter-function-body",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "sidecar:dev": "bun sidecar/main.ts",
    "sidecar:build": "bun run scripts/build-sidecar.ts",
    "tauri": "tauri",
    "tauri:dev": "bun run sidecar:build && tauri dev",
    "tauri:build": "bun run sidecar:build && tauri build",
    "rs:fmt": "cd src-tauri && cargo fmt",
    "rs:fmt:check": "cd src-tauri && cargo fmt --check",
    "rs:lint": "cd src-tauri && cargo clippy --all-targets -- -D warnings",
    "rs:test": "cd src-tauri && cargo test",
    "hooks:install": "git config core.hooksPath .githooks",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun test && bun run rs:fmt:check && bun run rs:lint && bun run rs:test"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.282",
    "@anthropic-ai/sdk": "^0.128.0",
    "@fontsource-variable/onest": "^5.3.1",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "~2.7.0",
    "clsx": "^2.1.1",
    "i18next": "^26.4.2",
    "lucide-react": "^1.27.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^17.0.15",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.11.1",
    "@oxlint/plugins": "1.79.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint-plugin-no-unsanitized": "4.1.5",
    "happy-dom": "^20.11.1",
    "oxlint": "1.79.0",
    "oxlint-plugin-react-doctor": "0.9.12",
    "oxlint-tailwindcss": "^1.10.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
