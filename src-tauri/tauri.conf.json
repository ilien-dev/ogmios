{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ogmios",
  "version": "../package.json",
  "identifier": "dev.ilien.ogmios",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1427",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Ogmios",
        "width": 1100,
        "height": 760,
        "minWidth": 720,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage", "dmg", "nsis"],
    "category": "Education",
    "shortDescription": "Speak English, get feedback at the end",
    "license": "AGPL-3.0-only",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/ogmios-agent"],
    "linux": {
      "deb": {
        "depends": ["libasound2"]
      },
      "rpm": {
        "depends": ["alsa-lib"]
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYwQzdDMEIyRTZBNzAyMDkKUldRSkFxZm1zc0RIOEdmMjIwU0hhK1EyYXFuMDBab1VHK0N0OXlrczVTaXFIL0UxUW1ydloxSGQK",
      "endpoints": [
        "https://github.com/ilien-dev/ogmios/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
